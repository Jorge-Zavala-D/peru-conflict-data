{
  "$defs": {
    "RateLimitHeader": {
      "additionalProperties": false,
      "description": "One explicitly allowlisted rate-limit response header.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "RateLimitHeader",
      "type": "object"
    },
    "RequestKind": {
      "description": "The only response-body purposes authorized during M1 discovery.",
      "enum": [
        "html",
        "robots"
      ],
      "title": "RequestKind",
      "type": "string"
    },
    "RequestOutcome": {
      "description": "Outcome of one actual HTTP transport attempt.",
      "enum": [
        "success",
        "redirect",
        "transient_http",
        "http_error",
        "transport_error",
        "rejected_content_type",
        "rejected_body_signature",
        "rejected_body_size",
        "rejected_redirect"
      ],
      "title": "RequestOutcome",
      "type": "string"
    },
    "SelectedHttpHeaders": {
      "additionalProperties": false,
      "description": "Fixed safe subset of response headers; never cookies or credentials.",
      "properties": {
        "content_length_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Length Original"
        },
        "content_type_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type Original"
        },
        "etag_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag Original"
        },
        "last_modified_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified Original"
        },
        "location_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Original"
        },
        "rate_limit_headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RateLimitHeader"
          },
          "title": "Rate Limit Headers",
          "type": "array"
        },
        "retry_after_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Original"
        }
      },
      "title": "SelectedHttpHeaders",
      "type": "object"
    }
  },
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/discovery/v0.3.0/request_attempt_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One actual request attempt, preserved before retry, rejection, or return.",
  "properties": {
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "body_byte_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Byte Count"
    },
    "body_complete": {
      "default": true,
      "title": "Body Complete",
      "type": "boolean"
    },
    "body_read": {
      "title": "Body Read",
      "type": "boolean"
    },
    "body_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Sha256"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "observation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Id"
    },
    "outcome": {
      "$ref": "#/$defs/RequestOutcome"
    },
    "receipt_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Receipt Id",
      "type": "string"
    },
    "redirect_index": {
      "minimum": 0,
      "title": "Redirect Index",
      "type": "integer"
    },
    "redirect_target_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redirect Target Url"
    },
    "request_kind": {
      "$ref": "#/$defs/RequestKind"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_url": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Requested Url",
      "type": "string"
    },
    "response_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Url"
    },
    "retry_delay_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Delay Seconds"
    },
    "retry_scheduled": {
      "default": false,
      "title": "Retry Scheduled",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_headers": {
      "$ref": "#/$defs/SelectedHttpHeaders"
    },
    "status_code": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "request_kind",
    "attempt_number",
    "redirect_index",
    "requested_url",
    "requested_at",
    "completed_at",
    "outcome",
    "selected_headers",
    "body_read"
  ],
  "title": "RequestAttemptReceipt",
  "type": "object"
}
