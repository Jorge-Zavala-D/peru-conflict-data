{
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/v0.1.0/agreement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agreement_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agreement Date"
    },
    "agreement_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Agreement Id",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "provenance_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provenance Ids",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "text_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Original"
    }
  },
  "required": [
    "agreement_id",
    "report_id"
  ],
  "title": "Agreement",
  "type": "object"
}
