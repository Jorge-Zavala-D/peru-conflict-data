{
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/v0.1.0/case_actor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Actor Id",
      "type": "string"
    },
    "case_actor_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Case Actor Id",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Case Id",
      "type": "string"
    },
    "provenance_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provenance Ids",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Report Id",
      "type": "string"
    },
    "role_normalized": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role Normalized"
    },
    "role_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role Original"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "case_actor_id",
    "case_id",
    "report_id",
    "actor_id"
  ],
  "title": "CaseActor",
  "type": "object"
}
