{
  "$defs": {
    "AdjudicationRecord": {
      "additionalProperties": false,
      "properties": {
        "adjudication_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Adjudication Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision_action": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Decision Action",
          "type": "string"
        },
        "decision_original": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Decision Original",
          "type": "string"
        },
        "decision_payload_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Payload Json"
        },
        "evidence_provenance_ids": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Provenance Ids",
          "type": "array"
        },
        "parser_version": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Parser Version",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Rationale",
          "type": "string"
        },
        "review_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Review Id",
          "type": "string"
        },
        "reviewer_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reviewer Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.3.1",
          "default": "0.3.1",
          "title": "Schema Version",
          "type": "string"
        },
        "second_reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Second Reviewed At"
        },
        "second_reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Second Reviewer Id"
        },
        "supersedes_adjudication_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Adjudication Id"
        }
      },
      "required": [
        "adjudication_id",
        "review_id",
        "decision_original",
        "decision_action",
        "rationale",
        "reviewer_id",
        "decided_at",
        "parser_version",
        "evidence_provenance_ids"
      ],
      "title": "AdjudicationRecord",
      "type": "object"
    },
    "AnnotationSlot": {
      "additionalProperties": false,
      "description": "One source-bounded object-instance field within an annotation unit.",
      "properties": {
        "benchmark_schema_version": {
          "const": "0.1.1",
          "default": "0.1.1",
          "title": "Benchmark Schema Version",
          "type": "string"
        },
        "cardinality_index": {
          "minimum": 0,
          "title": "Cardinality Index",
          "type": "integer"
        },
        "domain_object_type": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Domain Object Type",
          "type": "string"
        },
        "field_name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Field Name",
          "type": "string"
        },
        "unit_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "domain_object_type",
        "cardinality_index",
        "field_name"
      ],
      "title": "AnnotationSlot",
      "type": "object"
    },
    "AnnotationState": {
      "enum": [
        "observed",
        "explicit_zero",
        "not_reported",
        "not_applicable",
        "source_ambiguous",
        "structurally_unavailable",
        "illegible_uninspectable",
        "annotation_uncertain"
      ],
      "title": "AnnotationState",
      "type": "string"
    },
    "CandidateVersion": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "envelope_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Envelope Sha256",
          "type": "string"
        },
        "intended_use": {
          "default": "development",
          "enum": [
            "development",
            "reserved_evaluation",
            "retrospective_audit",
            "production_candidate"
          ],
          "title": "Intended Use",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "origin": {
          "enum": [
            "source_derived_machine_candidate",
            "synthetic_fixture"
          ],
          "title": "Origin",
          "type": "string"
        },
        "processed_unit_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Processed Unit Ids",
          "type": "array"
        },
        "processing": {
          "default": "incomplete",
          "enum": [
            "incomplete",
            "technically_valid",
            "requires_review"
          ],
          "title": "Processing",
          "type": "string"
        },
        "release": {
          "const": "internal_draft",
          "default": "internal_draft",
          "title": "Release",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        },
        "unresolved": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "version_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "run_id",
        "envelope_sha256",
        "origin"
      ],
      "title": "CandidateVersion",
      "type": "object"
    },
    "DerivedVersion": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/FieldAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "decision_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Decision Sha256",
          "type": "string"
        },
        "initial_candidate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Initial Candidate Sha256",
          "type": "string"
        },
        "origin": {
          "enum": [
            "source_first_pi_decision",
            "ai_assisted_pi_decision",
            "synthetic_fixture"
          ],
          "title": "Origin",
          "type": "string"
        },
        "processing": {
          "enum": [
            "requires_review",
            "resolved_derived_version"
          ],
          "title": "Processing",
          "type": "string"
        },
        "release": {
          "const": "internal_draft",
          "default": "internal_draft",
          "title": "Release",
          "type": "string"
        }
      },
      "required": [
        "initial_candidate_sha256",
        "decision_sha256",
        "origin",
        "processing",
        "annotations"
      ],
      "title": "DerivedVersion",
      "type": "object"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "properties": {
        "benchmark_schema_version": {
          "const": "0.1.1",
