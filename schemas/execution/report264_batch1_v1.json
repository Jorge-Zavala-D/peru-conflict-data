        "max_packets": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Packets",
          "type": "integer"
        },
        "max_pages": {
          "const": 30,
          "default": 30,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_pi_review_minutes": {
          "default": 180,
          "maximum": 180,
          "minimum": 1,
