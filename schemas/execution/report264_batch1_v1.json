        "report_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Report Id",
          "type": "string"
        },
        "report_number": {
          "const": 264,
          "default": 264,
          "title": "Report Number",
          "type": "integer"
        },
        "resource": {
          "$ref": "#/$defs/ResourceIdentity"
        },
        "schema_version": {
          "const": "report264-batch1-v1",
          "default": "report264-batch1-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_page_count": {
          "const": 104,
          "default": 104,
          "title": "Source Page Count",
          "type": "integer"
        },
        "source_path": {
          "format": "path",
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "const": "5d7e9a506d402915d994456fb9a69e371788613e583d8a215975705c7cad0ddd",
          "default": "5d7e9a506d402915d994456fb9a69e371788613e583d8a215975705c7cad0ddd",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_size_bytes": {
          "const": 4539029,
          "default": 4539029,
          "title": "Source Size Bytes",
          "type": "integer"
        },
        "token_usage": {
          "anyOf": [
            {
              "const": "UNOBSERVED",
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "default": "UNOBSERVED",
          "title": "Token Usage"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        }
      },
      "required": [
        "batch_id",
        "owner_instruction_id",
        "report_id",
        "source_path",
        "data_root",
        "output_root",
        "tool",
        "resource"
      ],
