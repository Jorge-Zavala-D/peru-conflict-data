{
  "$defs": {
    "AnnotationState": {
      "enum": [
        "observed",
        "explicit_zero",
        "not_reported",
        "not_applicable",
        "source_ambiguous",
        "structurally_unavailable",
        "illegible_uninspectable",
        "annotation_uncertain"
      ],
      "title": "AnnotationState",
      "type": "string"
    },
