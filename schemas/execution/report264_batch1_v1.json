          "type": "array"
        },
        "pi_review_minutes": {
          "default": 0.0,
          "minimum": 0,
          "title": "Pi Review Minutes",
          "type": "number"
        },
        "tasks": {
          "default": 0,
          "minimum": 0,
          "title": "Tasks",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "title": "BatchUsage",
      "type": "object"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "properties": {
        "benchmark_schema_version": {
          "const": "0.1.1",
          "default": "0.1.1",
          "title": "Benchmark Schema Version",
          "type": "string"
        },
        "granularity": {
          "$ref": "#/$defs/EvidenceGranularity"
