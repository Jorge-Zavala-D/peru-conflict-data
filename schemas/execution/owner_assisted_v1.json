        },
        "resource": {
          "enum": [
            "annotator-a/issue",
            "annotator-a/submission",
            "annotator-b/issue",
            "annotator-b/submission",
            "coordinator/custody",
            "coordinator/comparison",
            "coordinator/adjudication",
            "coordinator/held-out-sealed",
            "coordinator/receipts",
            "coordinator/locked/annotator-a",
            "coordinator/locked/annotator-b",
            "coordinator/supersession"
          ],
          "title": "Resource",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_ref": {
          "title": "Session Ref",
          "type": "string"
        },
        "state": {
          "enum": [
            "STARTED",
            "ACKNOWLEDGED_ASYNC",
            "COMPLETED",
            "UNKNOWN"
