          "const": "SYNTHETIC_NOT_HUMAN_SUBMISSION",
          "default": "SYNTHETIC_NOT_HUMAN_SUBMISSION",
          "title": "Evidence Label",
          "type": "string"
        },
        "gold": {
          "const": false,
          "default": false,
          "title": "Gold",
          "type": "boolean"
        },
        "kind": {
          "const": "MANUAL_ACCEPTED_ORIGINAL_V1",
          "default": "MANUAL_ACCEPTED_ORIGINAL_V1",
          "title": "Kind",
          "type": "string"
        },
        "original_intake_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Intake Sha256",
          "type": "string"
        },
        "permission_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Permission Sha256",
          "type": "string"
        },
        "previous_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Sha256"
        },
        "publication_evidence": {
          "items": {
            "$ref": "#/$defs/PinnedManualPublicationEvidence"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Publication Evidence",
          "type": "array"
        },
        "role": {
          "enum": [
            "annotator-a",
            "annotator-b"
