{
  "$defs": {
    "AccessExpectation": {
      "additionalProperties": false,
      "description": "One ACL outcome that a future real-account test must observe.",
      "properties": {
        "actor": {
          "enum": [
            "annotator-a",
            "annotator-b",
            "coordinator"
          ],
          "title": "Actor",
          "type": "string"
        },
        "check_id": {
          "pattern": "^[a-z0-9][a-z0-9/-]*$",
          "title": "Check Id",
          "type": "string"
        },
        "control_layer": {
          "const": "ACL",
          "default": "ACL",
          "title": "Control Layer",
          "type": "string"
        },
        "expected_outcome": {
          "enum": [
            "ALLOW",
            "DENY"
          ],
          "title": "Expected Outcome",
          "type": "string"
        },
        "operation": {
          "enum": [
            "list",
            "read",
            "write"
          ],
          "title": "Operation",
          "type": "string"
        },
        "rationale_id": {
          "pattern": "^ACL-[A-Z0-9-]+$",
          "title": "Rationale Id",
          "type": "string"
        },
        "resource": {
          "enum": [
            "annotator-a/issue",
            "annotator-a/submission",
            "annotator-b/issue",
            "annotator-b/submission",
            "coordinator/custody",
            "coordinator/comparison",
            "coordinator/adjudication",
            "coordinator/held-out-sealed",
            "coordinator/receipts",
            "coordinator/locked/annotator-a",
            "coordinator/locked/annotator-b",
            "coordinator/supersession"
          ],
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "actor",
        "resource",
        "operation",
        "expected_outcome",
        "rationale_id"
      ],
      "title": "AccessExpectation",
      "type": "object"
    },
    "AnnotationContractIdentity": {
      "additionalProperties": false,
      "properties": {
        "benchmark_schema_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Benchmark Schema Digest",
          "type": "string"
        },
        "benchmark_schema_version": {
          "const": "0.1.1",
          "title": "Benchmark Schema Version",
          "type": "string"
        },
        "critical_field_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Critical Field Set Sha256",
          "type": "string"
        },
        "date_correction_approval_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Date Correction Approval Sha256",
          "type": "string"
        },
        "date_pair_interpretation_approval_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Date Pair Interpretation Approval Sha256",
          "type": "string"
        },
        "date_pair_interpretation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Date Pair Interpretation Sha256",
          "type": "string"
        },
        "discovery_policy_approval_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Discovery Policy Approval Sha256",
          "type": "string"
        },
        "evaluator_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evaluator Sha256",
          "type": "string"
        },
        "metric_contract_version": {
          "const": "0.1.1",
          "title": "Metric Contract Version",
          "type": "string"
        },
        "owner_readiness_approval_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Owner Readiness Approval Sha256",
          "type": "string"
        },
        "scientific_schema_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scientific Schema Digest",
          "type": "string"
        },
        "scientific_schema_version": {
          "const": "0.3.1",
          "title": "Scientific Schema Version",
          "type": "string"
        }
      },
      "required": [
        "scientific_schema_version",
        "scientific_schema_digest",
        "benchmark_schema_version",
        "benchmark_schema_digest",
        "metric_contract_version",
        "evaluator_sha256",
        "critical_field_set_sha256",
        "date_correction_approval_sha256",
        "discovery_policy_approval_sha256",
        "date_pair_interpretation_sha256",
        "date_pair_interpretation_approval_sha256",
        "owner_readiness_approval_sha256"
      ],
      "title": "AnnotationContractIdentity",
      "type": "object"
    },
    "EligibilityBinding": {
      "additionalProperties": false,
      "description": "Coordinator-only; opaque token digests are private, never annotator material.",
      "properties": {
        "annotation_launch_approved": {
          "const": false,
          "default": false,
          "title": "Annotation Launch Approved",
          "type": "boolean"
        },
        "attestation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Attestation Sha256",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/IssuedPackageIdentity"
        },
        "kind": {
          "const": "COORDINATOR_ONLY_ELIGIBILITY_BINDING",
          "default": "COORDINATOR_ONLY_ELIGIBILITY_BINDING",
          "title": "Kind",
          "type": "string"
        },
        "owner_readiness_approved": {
          "const": false,
          "default": false,
          "title": "Owner Readiness Approved",
          "type": "boolean"
        },
        "private_person_token_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Private Person Token Sha256",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "identity",
        "attestation_sha256",
        "private_person_token_sha256"
      ],
      "title": "EligibilityBinding",
      "type": "object"
    },
    "IssuedPackageIdentity": {
      "additionalProperties": false,
      "description": "Neutral source/protocol identity; contains neither personnel nor partition labels.",
      "properties": {
        "contract_identity": {
          "$ref": "#/$defs/AnnotationContractIdentity"
        },
        "execution_policy_version": {
          "const": "m2-02-execution-policy-v1",
          "default": "m2-02-execution-policy-v1",
          "title": "Execution Policy Version",
          "type": "string"
        },
        "file_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Set Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "neutral_reader_contract": {
          "const": "m2-neutral-reader-contract-v1",
          "default": "m2-neutral-reader-contract-v1",
          "title": "Neutral Reader Contract",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Package Id",
          "type": "string"
        },
        "reference_aggregate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Reference Aggregate Sha256",
          "type": "string"
        },
        "reference_policy_sha256s": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Reference Policy Sha256S",
          "type": "array"
        },
        "role": {
          "enum": [
            "annotator-a",
            "annotator-b"
          ],
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "enum": [
            "m2-02-v1",
            "synthetic-run"
          ],
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "package_id",
        "contract_identity",
        "manifest_sha256",
        "reference_aggregate_sha256",
        "file_set_sha256",
        "reference_policy_sha256s"
      ],
      "title": "IssuedPackageIdentity",
      "type": "object"
    },
    "ManualAcceptedOriginal": {
      "additionalProperties": false,
      "properties": {
        "admission_sha256": {
          "pattern": "^[a-f0-9]{64}$",
