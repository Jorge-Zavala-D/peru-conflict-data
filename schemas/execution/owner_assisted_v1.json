        "role",
        "sequence",
        "original_intake_sha256",
        "previous_sha256",
        "supersedes",
        "permission_sha256",
        "completion_sha256",
        "confirmation_sha256",
        "publication_evidence"
      ],
      "title": "ManualAcceptedOriginal",
      "type": "object"
    },
    "ManualActionEvent": {
      "additionalProperties": false,
