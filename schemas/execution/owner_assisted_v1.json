        "action_ref",
        "kind",
        "state",
        "at",
        "binding_sha256",
        "actor",
        "resource",
        "session_ref",
        "namespace",
        "target_id",
        "witness_ref",
        "evidence_sha256"
      ],
      "title": "ManualActionEvent",
      "type": "object"
    },
