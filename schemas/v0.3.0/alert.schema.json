{
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/v0.3.0/alert.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alert_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alert Date"
    },
    "alert_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Alert Id",
      "type": "string"
    },
    "alert_type_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alert Type Original"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "location_text_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Text Original"
    },
    "provenance_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provenance Ids",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Report Id",
      "type": "string"
    },
    "risk_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Original"
    },
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "text_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Original"
    }
  },
  "required": [
    "alert_id",
    "report_id"
  ],
  "title": "Alert",
  "type": "object"
}
