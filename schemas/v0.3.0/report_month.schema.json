{
  "$defs": {
    "IndicatorBasis": {
      "description": "Whether a monthly indicator is copied from a source or calculated.",
      "enum": [
        "source_reported",
        "derived"
      ],
      "title": "IndicatorBasis",
      "type": "string"
    }
  },
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/v0.3.0/report_month.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "indicator_basis": {
            "const": "source_reported"
          }
        },
        "required": [
          "indicator_basis"
        ]
      },
      "then": {
        "properties": {
          "derivation_name": {
            "type": "null"
          },
          "derivation_version": {
            "type": "null"
          },
          "provenance_ids": {
            "minItems": 1
          },
          "upstream_record_ids": {
            "maxItems": 0
          }
        },
        "required": [
          "provenance_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "indicator_basis": {
            "const": "derived"
          }
        },
        "required": [
          "indicator_basis"
        ]
      },
      "then": {
        "properties": {
          "derivation_name": {
            "minLength": 1,
            "type": "string"
          },
          "derivation_version": {
            "minLength": 1,
            "type": "string"
          },
          "upstream_record_ids": {
            "minItems": 1
          }
        },
        "required": [
          "derivation_name",
          "derivation_version",
          "upstream_record_ids"
        ]
      }
    }
  ],
  "properties": {
    "derivation_name": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derivation Name"
    },
    "derivation_version": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derivation Version"
    },
    "indicator_basis": {
      "$ref": "#/$defs/IndicatorBasis"
    },
    "metric_original": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Metric Original",
      "type": "string"
    },
    "provenance_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Provenance Ids",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Report Id",
      "type": "string"
    },
    "report_month_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Report Month Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Original"
    },
    "unit_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Original"
    },
    "upstream_record_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Upstream Record Ids",
      "type": "array"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "report_month_id",
    "report_id",
    "metric_original",
    "indicator_basis"
  ],
  "title": "ReportMonthAggregate",
  "type": "object"
}
