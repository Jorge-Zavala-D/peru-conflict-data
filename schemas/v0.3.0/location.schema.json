{
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/v0.3.0/location.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "crosswalk_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crosswalk Version"
    },
    "department_normalized": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Department Normalized"
    },
    "department_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Department Original"
    },
    "district_normalized": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "District Normalized"
    },
    "district_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "District Original"
    },
    "location_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Location Id",
      "type": "string"
    },
    "location_text_original": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Location Text Original",
      "type": "string"
    },
    "match_confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match Confidence"
    },
    "match_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match Method"
    },
    "population_center_normalized": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Population Center Normalized"
    },
    "population_center_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Population Center Original"
    },
    "provenance_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Provenance Ids",
      "type": "array"
    },
    "province_normalized": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Province Normalized"
    },
    "province_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Province Original"
    },
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ubigeo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ubigeo"
    }
  },
  "required": [
    "location_id",
    "location_text_original"
  ],
  "title": "Location",
  "type": "object"
}
