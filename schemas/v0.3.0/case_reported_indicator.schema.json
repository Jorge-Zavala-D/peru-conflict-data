{
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/v0.3.0/case_reported_indicator.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "provenance_ids": {
          "minItems": 1
        },
        "value": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "value",
        "provenance_ids"
      ]
    }
  ],
  "description": "A value the source reports for a case-month, never a value derived from events.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Case Id",
      "type": "string"
    },
    "case_month_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Case Month Id",
      "type": "string"
    },
    "case_reported_indicator_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Case Reported Indicator Id",
      "type": "string"
    },
    "metric_original": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Metric Original",
      "type": "string"
    },
    "provenance_ids": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Ids",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Original"
    },
    "unit_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Original"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "case_reported_indicator_id",
    "case_month_id",
    "case_id",
    "report_id",
    "metric_original",
    "value",
    "provenance_ids"
  ],
  "title": "CaseReportedIndicator",
  "type": "object"
}
