  "description": "A structurally closed v2 pilot whose exact bytes are pinned by its loader.",
  "properties": {
    "approved_hosts": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Approved Hosts",
      "type": "array"
    },
    "authorization_status": {
      "const": "not_authorized",
      "title": "Authorization Status",
      "type": "string"
    },
    "baseline_receipt_git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Baseline Receipt Git Commit",
      "type": "string"
    },
    "baseline_receipt_path": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Baseline Receipt Path",
      "type": "string"
    },
    "baseline_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Baseline Receipt Sha256",
      "type": "string"
    },
    "dry_run": {
      "$ref": "#/$defs/PilotDryRun"
    },
    "limits": {
      "$ref": "#/$defs/PilotLimits"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Plan Id",
      "type": "string"
    },
    "promotion_policy": {
      "$ref": "#/$defs/PilotPromotionPolicy"
    },
    "purpose": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/PilotTarget"
      },
      "title": "Targets",
