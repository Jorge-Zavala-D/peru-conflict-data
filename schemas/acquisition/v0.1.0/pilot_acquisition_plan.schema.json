{
  "$defs": {
    "PilotDryRun": {
      "additionalProperties": false,
      "description": "The only currently authorized use of the future-acquisition recipe.",
      "properties": {
        "behavior": {
          "const": "validate_and_print_plan_only",
          "title": "Behavior",
          "type": "string"
        },
        "dropbox_writes": {
          "const": 0,
          "title": "Dropbox Writes",
          "type": "integer"
        },
        "network_requests": {
          "const": 0,
          "title": "Network Requests",
          "type": "integer"
        }
      },
      "required": [
        "network_requests",
        "dropbox_writes",
        "behavior"
      ],
      "title": "PilotDryRun",
      "type": "object"
    },
    "PilotLimits": {
      "additionalProperties": false,
      "description": "Hard future-acquisition envelope; every transport attempt consumes the budget.",
      "properties": {
        "attempts_include": {
          "items": {
            "enum": [
              "robots",
              "initial_requests",
              "redirect_hops",
              "retries"
            ],
            "type": "string"
          },
          "title": "Attempts Include",
          "type": "array"
        },
        "concurrency": {
          "const": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "delay_seconds": {
          "maximum": 2.0,
          "minimum": 2.0,
          "title": "Delay Seconds",
          "type": "number"
        },
        "global_budget_behavior": {
          "const": "stop_before_request_when_budget_exhausted",
          "title": "Global Budget Behavior",
          "type": "string"
        },
        "max_redirects_per_url": {
          "const": 5,
          "title": "Max Redirects Per Url",
          "type": "integer"
        },
        "max_reports": {
          "const": 10,
          "title": "Max Reports",
          "type": "integer"
        },
        "max_total_attempts": {
          "const": 60,
          "title": "Max Total Attempts",
          "type": "integer"
        },
        "max_urls": {
          "const": 20,
          "title": "Max Urls",
          "type": "integer"
        },
        "per_file_max_bytes": {
          "const": 50000000,
          "title": "Per File Max Bytes",
          "type": "integer"
        },
        "per_file_min_bytes": {
          "const": 1024,
          "title": "Per File Min Bytes",
          "type": "integer"
        },
        "retry_cap": {
          "const": 2,
          "title": "Retry Cap",
          "type": "integer"
        },
        "timeout_seconds": {
          "const": 30,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "total_download_max_bytes": {
          "const": 500000000,
          "title": "Total Download Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "max_reports",
        "max_urls",
        "concurrency",
        "delay_seconds",
        "retry_cap",
        "timeout_seconds",
        "max_redirects_per_url",
        "max_total_attempts",
        "attempts_include",
        "global_budget_behavior",
        "per_file_min_bytes",
        "per_file_max_bytes",
        "total_download_max_bytes"
      ],
      "title": "PilotLimits",
      "type": "object"
    },
    "PilotPromotionPolicy": {
      "additionalProperties": false,
      "description": "Fail-closed validation and future same-filesystem promotion semantics.",
      "properties": {
        "atomic_promotion_required": {
          "const": true,
          "title": "Atomic Promotion Required",
          "type": "boolean"
        },
        "different_from_existing_action": {
          "const": "stop_for_review_before_raw_promotion",
          "title": "Different From Existing Action",
          "type": "string"
        },
        "disposition_order": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Disposition Order",
          "type": "array"
        },
        "failure_action": {
          "const": "abandon_promotion_preserve_receipt_then_remove_temp",
          "title": "Failure Action",
          "type": "string"
        },
        "identical_bytes_multiple_urls_action": {
          "const": "preserve_all_url_observations_one_byte_object",
          "title": "Identical Bytes Multiple Urls Action",
          "type": "string"
        },
        "identical_to_existing_action": {
          "const": "record_observation_no_duplicate_raw_file",
          "title": "Identical To Existing Action",
          "type": "string"
        },
        "pre_network_validation_order": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Pre Network Validation Order",
          "type": "array"
        },
        "response_validation_order": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "title": "Response Validation Order",
          "type": "array"
        },
        "same_filesystem_staging_location": {
          "const": "conflict_data_root/01_raw/.staging/m1-03-pilot-260-269",
          "title": "Same Filesystem Staging Location",
          "type": "string"
        },
        "staging_behavior": {
          "const": "copy_stream_rehash_then_atomic_rename",
          "title": "Staging Behavior",
          "type": "string"
        },
        "temporary_location": {
          "const": "system_temp/peru-conflict-data/m1-03-pilot-260-269",
          "title": "Temporary Location",
          "type": "string"
        }
      },
      "required": [
        "temporary_location",
        "same_filesystem_staging_location",
        "staging_behavior",
        "pre_network_validation_order",
        "response_validation_order",
        "disposition_order",
        "different_from_existing_action",
        "identical_to_existing_action",
        "identical_bytes_multiple_urls_action",
        "failure_action",
        "atomic_promotion_required"
      ],
      "title": "PilotPromotionPolicy",
      "type": "object"
    },
    "PilotTarget": {
      "additionalProperties": false,
      "description": "One pinned public URL pair and its existing local benchmark receipt.",
      "properties": {
        "association_status": {
          "enum": [
            "visibly_associated",
            "unresolved_association"
          ],
          "title": "Association Status",
          "type": "string"
        },
        "candidate_reference_period": {
          "pattern": "^\\d{4}-\\d{2}$",
          "title": "Candidate Reference Period",
          "type": "string"
        },
        "direct_download_url": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Direct Download Url",
          "type": "string"
        },
        "existing_local_byte_count": {
          "minimum": 1,
          "title": "Existing Local Byte Count",
          "type": "integer"
        },
        "existing_local_relative_path": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Existing Local Relative Path",
          "type": "string"
        },
        "existing_local_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Existing Local Sha256",
          "type": "string"
        },
        "expected_remote_sha256": {
          "default": null,
          "title": "Expected Remote Sha256",
          "type": "null"
        },
        "landing_page_url": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Landing Page Url",
          "type": "string"
        },
        "publication_date_original": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Publication Date Original",
          "type": "string"
        },
        "remote_hash_status": {
          "const": "unknown_until_authorized_fetch",
          "title": "Remote Hash Status",
          "type": "string"
        },
        "report_number": {
          "maximum": 269,
          "minimum": 260,
          "title": "Report Number",
          "type": "integer"
        },
        "uncertainty_codes": {
          "default": [],
          "items": {
            "enum": [
              "opaque_filename",
              "unresolved_association"
            ],
            "type": "string"
          },
          "title": "Uncertainty Codes",
          "type": "array"
        },
        "uncertainty_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Note"
        }
      },
      "required": [
        "report_number",
        "candidate_reference_period",
        "publication_date_original",
        "landing_page_url",
        "direct_download_url",
        "association_status",
        "existing_local_relative_path",
        "existing_local_byte_count",
        "existing_local_sha256",
        "remote_hash_status"
      ],
      "title": "PilotTarget",
      "type": "object"
    }
  },
