{
  "$defs": {
    "AcquisitionFailureStage": {
      "description": "Stage at which a non-attempt or policy-level acquisition failure occurred.",
      "enum": [
        "robots_body",
        "robots_policy",
        "response_close",
        "temp_cleanup"
      ],
      "title": "AcquisitionFailureStage",
      "type": "string"
    }
  },
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/acquisition/v0.1.0/acquisition_failure_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "robots_body",
              "response_close",
              "temp_cleanup"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "related_attempt_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "related_attempt_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "robots_policy"
          }
        }
      },
      "then": {
        "properties": {
          "related_attempt_id": {
            "const": null
          }
        }
      }
    }
  ],
  "description": "A policy/body/cleanup failure not fully represented by an HTTP attempt.",
  "properties": {
    "cleanup_completed": {
      "title": "Cleanup Completed",
      "type": "boolean"
    },
    "error_code": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Error Code",
      "type": "string"
    },
    "error_message": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Error Message",
      "type": "string"
    },
    "failure_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Failure Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Plan Id",
      "type": "string"
    },
    "related_attempt_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Attempt Id"
    },
    "report_number": {
      "maximum": 269,
      "minimum": 260,
      "title": "Report Number",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/AcquisitionFailureStage"
    },
    "transferred_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Transferred Bytes",
      "type": "integer"
    },
    "url": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "failure_id",
    "run_id",
    "plan_id",
    "report_number",
    "stage",
    "url",
    "occurred_at",
    "error_code",
    "error_message",
    "cleanup_completed"
  ],
  "title": "AcquisitionFailureReceipt",
  "type": "object"
}
