            "const": "failure"
          }
        }
      },
      "then": {
        "properties": {
          "attempt": {
            "const": null
          },
          "collision_evidence_summary": {
            "const": null
          },
          "disposition": {
            "const": null
          },
          "expected_source_sha256": {
            "const": null
          },
