            "const": null
          },
          "report_number": {
            "const": null
          },
          "source_attempt_id": {
            "const": null
          },
          "terminal_status": {
            "const": null
          },
          "url_role": {
            "const": null
          },
          "version_relationship": {
            "const": null
          }
        },
        "required": [
          "failure"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "url_observation"
          }
        }
      },
      "then": {
        "properties": {
          "attempt": {
            "const": null
          },
          "collision_evidence_summary": {
            "const": null
          },
          "disposition": {
            "const": "identical_no_duplicate_raw_file"
          },
          "failure": {
            "const": null
          },
          "terminal_status": {
            "const": null
          },
          "version_relationship": {
            "const": "identical_bytes"
          }
        },
        "required": [
          "report_number",
          "url_role",
          "normalized_url",
          "observed_sha256",
          "observed_bytes",
          "expected_source_sha256",
          "disposition",
          "version_relationship",
          "local_relative_path",
          "source_attempt_id"
        ]
      }
    },
