  "description": "Typed append-only record for a future Dropbox operational ledger.",
  "properties": {
    "attempt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcquisitionAttemptReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "collision_evidence_summary": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collision Evidence Summary"
    },
    "disposition": {
      "anyOf": [
        {
