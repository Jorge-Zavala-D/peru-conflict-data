{
  "$defs": {
    "AcquisitionAttemptOutcome": {
      "enum": [
        "success",
        "redirect",
        "retryable_failure",
        "rejected",
        "interrupted"
      ],
      "title": "AcquisitionAttemptOutcome",
      "type": "string"
    },
    "AcquisitionRequestKind": {
      "enum": [
        "robots",
        "landing_html",
        "pdf"
      ],
      "title": "AcquisitionRequestKind",
      "type": "string"
    },
    "SafeRateLimitHeader": {
      "additionalProperties": false,
      "description": "One allowlisted rate-limit header without request-secret material.",
      "properties": {
        "name": {
          "enum": [
            "ratelimit-limit",
            "ratelimit-remaining",
            "ratelimit-reset",
            "x-rate-limit-limit",
            "x-rate-limit-remaining",
            "x-rate-limit-reset",
            "x-ratelimit-limit",
            "x-ratelimit-remaining",
            "x-ratelimit-reset"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "pattern": "^[^\\r\\n]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SafeRateLimitHeader",
      "type": "object"
    },
    "SafeResponseHeaders": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "location_sanitized": {
                "type": "string"
              }
            },
            "required": [
              "location_sanitized"
            ]
          },
          "then": {
            "properties": {
              "location_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "location_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "location_sha256": {
                "type": "string"
              }
            },
            "required": [
              "location_sha256"
            ]
          },
          "then": {
            "properties": {
              "location_sanitized": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "location_sanitized"
            ]
          }
        }
      ],
      "description": "Selected response evidence; request credentials and cookies are never retained.",
      "properties": {
        "content_encoding_original": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Encoding Original"
        },
        "content_length_original": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Length Original"
        },
        "content_type_original": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type Original"
        },
        "etag_original": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag Original"
        },
        "last_modified_original": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified Original"
        },
        "location_sanitized": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Sanitized"
        },
        "location_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Sha256"
        },
        "rate_limit_headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SafeRateLimitHeader"
          },
          "title": "Rate Limit Headers",
          "type": "array"
        },
        "retry_after_original": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Original"
        }
      },
      "title": "SafeResponseHeaders",
      "type": "object"
    }
  },
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/acquisition/v0.1.0/acquisition_attempt_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "complete_body_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "error_code": {
            "const": null
          },
          "error_message": {
            "const": null
          },
          "redirect_target_url": {
            "const": null
          },
          "status_code": {
            "maximum": 299,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [
          "status_code",
          "complete_body_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "redirect"
          }
        }
      },
      "then": {
        "properties": {
          "complete_body_sha256": {
            "const": null
          },
          "error_code": {
            "const": null
          },
          "error_message": {
            "const": null
          },
          "redirect_target_url": {
            "minLength": 1,
            "type": "string"
          },
          "response_headers": {
            "allOf": [
              {
                "$ref": "#/$defs/SafeResponseHeaders"
              },
              {
                "properties": {
                  "location_sanitized": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "location_sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "location_sanitized",
                  "location_sha256"
                ]
              }
            ]
          },
          "status_code": {
            "enum": [
              301,
              302,
              303,
              307,
              308
            ]
          },
          "transferred_bytes": {
            "const": 0
          }
        },
        "required": [
          "status_code",
          "redirect_target_url",
          "response_headers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "retryable_failure"
          }
        }
      },
      "then": {
        "properties": {
          "complete_body_sha256": {
            "const": null
          },
          "error_code": {
            "minLength": 1,
            "type": "string"
          },
          "redirect_target_url": {
            "const": null
          }
        },
        "required": [
          "error_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "complete_body_sha256": {
            "const": null
          },
          "error_code": {
            "minLength": 1,
            "type": "string"
          },
          "redirect_target_url": {
            "const": null
          }
        },
        "required": [
          "error_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "interrupted"
          }
        }
      },
      "then": {
        "properties": {
          "complete_body_sha256": {
            "const": null
          },
          "error_code": {
            "minLength": 1,
            "type": "string"
          },
          "redirect_target_url": {
            "const": null
          }
        },
        "required": [
          "error_code"
        ]
      }
    }
  ],
  "description": "One future acquisition attempt, including rejected or interrupted streams.",
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "complete_body_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Complete Body Sha256"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "outcome": {
      "$ref": "#/$defs/AcquisitionAttemptOutcome"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Plan Id",
      "type": "string"
    },
    "redirect_index": {
      "minimum": 0,
      "title": "Redirect Index",
      "type": "integer"
    },
    "redirect_target_url": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redirect Target Url"
    },
    "report_number": {
      "maximum": 269,
      "minimum": 260,
      "title": "Report Number",
      "type": "integer"
    },
    "request_kind": {
      "$ref": "#/$defs/AcquisitionRequestKind"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "response_headers": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafeResponseHeaders"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status_code": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    },
    "transferred_bytes": {
      "minimum": 0,
      "title": "Transferred Bytes",
      "type": "integer"
    },
    "url": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "plan_id",
    "report_number",
    "request_kind",
    "url",
    "attempt_number",
    "redirect_index",
    "requested_at",
    "completed_at",
    "outcome",
    "transferred_bytes"
  ],
  "title": "AcquisitionAttemptReceipt",
  "type": "object"
}
