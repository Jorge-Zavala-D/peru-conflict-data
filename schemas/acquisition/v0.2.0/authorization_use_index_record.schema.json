{
  "$defs": {
    "UseIndexClaimV2": {
      "additionalProperties": false,
      "properties": {
        "authorization_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authorization Artifact Sha256",
          "type": "string"
        },
        "authorization_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Authorization Id",
          "type": "string"
        },
        "data_root_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Root Identity Sha256",
          "type": "string"
        },
        "execution_host_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Host Identity Sha256",
          "type": "string"
        },
        "index_sequence": {
          "minimum": 1,
          "title": "Index Sequence",
          "type": "integer"
        },
        "plan_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Plan Id",
          "type": "string"
        },
        "previous_index_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Index Sha256"
        },
        "record_type": {
          "const": "authorization_claim",
          "title": "Record Type",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_namespace_marker_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Storage Namespace Marker Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "index_sequence",
        "previous_index_sha256",
        "authorization_id",
        "run_id",
        "recorded_at",
        "record_type",
        "plan_id",
        "authorization_artifact_sha256",
        "storage_namespace_marker_sha256",
        "data_root_identity_sha256",
        "execution_host_identity_sha256"
      ],
      "title": "UseIndexClaimV2",
      "type": "object"
    },
