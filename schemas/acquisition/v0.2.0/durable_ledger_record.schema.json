{
  "$defs": {
    "DurableAttemptFinishedV2": {
      "additionalProperties": false,
      "properties": {
        "accepted_bytes": {
          "anyOf": [
            {
              "maximum": 500000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Bytes"
        },
        "attempt_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_ordinal": {
          "maximum": 60,
          "minimum": 1,
          "title": "Attempt Ordinal",
          "type": "integer"
        },
        "authorization_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Authorization Id",
          "type": "string"
        },
        "body_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Sha256"
        },
        "error_code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "outcome": {
          "enum": [
            "success",
            "redirect",
            "rejected",
            "retryable_failure",
            "interrupted",
            "crash_outcome_unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Plan Id",
          "type": "string"
        },
        "previous_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Record Sha256"
        },
        "record_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "attempt_finished",
          "title": "Record Type",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "response_headers": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeResponseHeaders"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        }
      },
      "required": [
        "schema_version",
        "record_id",
        "authorization_id",
        "run_id",
        "plan_id",
        "sequence",
        "previous_record_sha256",
        "recorded_at",
        "record_type",
        "attempt_id",
        "attempt_ordinal",
        "outcome",
        "body_sha256",
        "error_code",
        "response_headers"
      ],
      "title": "DurableAttemptFinishedV2",
      "type": "object"
    },
