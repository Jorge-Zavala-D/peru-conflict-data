{
  "$defs": {
    "ArtifactFingerprint": {
      "additionalProperties": false,
      "description": "Portable path and immutable byte fingerprint for one input/output artifact.",
      "properties": {
        "artifact_role": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Artifact Role",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Path",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_role",
        "path",
        "bytes",
        "sha256"
      ],
      "title": "ArtifactFingerprint",
      "type": "object"
    },
    "GapClassification": {
      "description": "Scientifically distinct unresolved candidate conditions.",
      "enum": [
        "historical_month_unresolved",
        "unobserved_report_number",
        "historical_unnumbered_source_lead",
        "byte_acquisition_not_established",
        "opaque_direct_file_association",
        "multiple_direct_url_bytes_unknown",
        "source_metadata_requires_review"
      ],
      "title": "GapClassification",
      "type": "string"
    }
  },
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/manifest/v0.1.0/coverage_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic M1-04A summary that cannot claim final completeness.",
  "properties": {
    "byte_verified_report_count": {
      "minimum": 0,
      "title": "Byte Verified Report Count",
      "type": "integer"
    },
    "byte_verified_report_max": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Verified Report Max"
    },
    "byte_verified_report_min": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Verified Report Min"
    },
    "candidate_completeness_status": {
      "const": "candidate_requires_human_review",
      "title": "Candidate Completeness Status",
      "type": "string"
    },
    "historical_bundle_lead_years": {
      "items": {
        "type": "integer"
      },
      "title": "Historical Bundle Lead Years",
      "type": "array"
    },
    "human_review_required": {
      "const": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "implementation_git_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Implementation Git Sha",
      "type": "string"
    },
    "input_artifact_fingerprints": {
      "items": {
        "$ref": "#/$defs/ArtifactFingerprint"
      },
      "minItems": 1,
      "title": "Input Artifact Fingerprints",
      "type": "array"
    },
    "manifest_schema_version": {
      "const": "0.1.0",
      "title": "Manifest Schema Version",
      "type": "string"
    },
    "materializer_version": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Materializer Version",
      "type": "string"
    },
    "month_to_report_conflict_count": {
      "minimum": 0,
      "title": "Month To Report Conflict Count",
      "type": "integer"
    },
    "observation_cutoff": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Observation Cutoff",
      "type": "string"
    },
    "observed_numbered_report_count": {
      "minimum": 0,
      "title": "Observed Numbered Report Count",
      "type": "integer"
    },
    "observed_numbered_report_max": {
      "minimum": 1,
      "title": "Observed Numbered Report Max",
      "type": "integer"
    },
    "observed_numbered_report_min": {
      "minimum": 1,
      "title": "Observed Numbered Report Min",
      "type": "integer"
    },
    "observed_reference_month_count": {
      "minimum": 0,
      "title": "Observed Reference Month Count",
      "type": "integer"
    },
    "observed_reference_month_max": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Observed Reference Month Max",
      "type": "string"
    },
    "observed_reference_month_min": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Observed Reference Month Min",
      "type": "string"
    },
    "report_to_month_conflict_count": {
      "minimum": 0,
      "title": "Report To Month Conflict Count",
      "type": "integer"
    },
    "reports_1_22_status": {
      "const": "unobserved_report_number_hypotheses",
      "title": "Reports 1 22 Status",
      "type": "string"
    },
    "research_coverage_start": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Research Coverage Start",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_gap_counts": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "$ref": "#/$defs/GapClassification"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Unresolved Gap Counts",
      "type": "array"
    }
  },
  "required": [
    "research_coverage_start",
    "observation_cutoff",
    "observed_numbered_report_min",
    "observed_numbered_report_max",
    "observed_numbered_report_count",
    "observed_reference_month_min",
    "observed_reference_month_max",
    "observed_reference_month_count",
    "report_to_month_conflict_count",
    "month_to_report_conflict_count",
    "historical_bundle_lead_years",
    "reports_1_22_status",
    "byte_verified_report_count",
    "unresolved_gap_counts",
    "candidate_completeness_status",
    "human_review_required",
    "input_artifact_fingerprints",
    "implementation_git_sha",
    "manifest_schema_version",
    "materializer_version"
  ],
  "title": "CoverageReport",
  "type": "object"
}
