{
  "$defs": {
    "PartitionRole": {
      "enum": [
        "protocol_pilot",
        "parser_development",
        "held_out_evaluation"
      ],
      "title": "PartitionRole",
      "type": "string"
    }
  },
  "$id": "https://github.com/Jorge-Zavala-D/peru-conflict-data/schemas/benchmark/v0.1.1/benchmark_partition_assignment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_schema_version": {
      "const": "0.1.1",
      "default": "0.1.1",
      "title": "Benchmark Schema Version",
      "type": "string"
    },
    "report_number": {
      "minimum": 1,
      "title": "Report Number",
      "type": "integer"
    },
    "role": {
      "$ref": "#/$defs/PartitionRole"
    }
  },
  "required": [
    "report_number",
    "role"
  ],
  "title": "BenchmarkPartitionAssignment",
  "type": "object"
}
